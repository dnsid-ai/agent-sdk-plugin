{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/verify/hook.js\" || exit 2",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/online/hook.js\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
