{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/verify/hook.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/online/hook.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
