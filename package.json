{
  "name": "@dnsid-ai/agent-sdk-plugin",
  "version": "0.0.1",
  "description": "DNSid for agents on the Claude Agent SDK, as a plugin: verify peers, sign requests, bring the agent online.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./verify": {
      "types": "./dist/verify/verifier.d.ts",
      "default": "./dist/verify/verifier.js"
    }
  },
  "files": [
    "dist",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "skills/*/SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsid-ai/agent-sdk-plugin.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run build && vitest run",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "alice": "node examples/minimal/alice.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "smoke:pack": "sh scripts/smoke-pack.sh",
    "version": "node scripts/sync-plugin-version.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1101.0",
    "@dnsid-ai/http-signatures": "^0.24.0",
    "@dnsid-ai/key-aws": "^0.24.0",
    "@dnsid-ai/log-c2sp-tlog": "^0.24.0",
    "@dnsid-ai/registry": "^0.24.0",
    "@dnsid-ai/sdk": "^0.24.0",
    "@dnsid-ai/transport": "^0.24.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@dnsid-ai/protocol": "^0.24.0",
    "@types/node": "^26.1.2",
    "jose": "^6.2.7",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
