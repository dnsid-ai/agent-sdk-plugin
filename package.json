{
  "name": "@identity-digital/dnsid-agent-sdk-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "DNSid for agents on the Claude Agent SDK, as a plugin: verify peers, sign requests, bring the agent online.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./verify": "./src/verify/verifier.ts"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnsid-ai/agent-sdk-plugin.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "link-sdk": "npm install --no-save --no-package-lock ../dnsid-ts/packages/core ../dnsid-ts/packages/transport ../dnsid-ts/packages/log-c2sp-tlog ../dnsid-ts/packages/sdk ../dnsid-ts/packages/registry ../dnsid-ts/packages/http-signatures ../dnsid-ts/packages/web-bot-auth ../dnsid-ts/packages/key-aws",
    "alice": "node examples/alice.ts"
  },
  "dependencies": {
    "@identity-digital/dnsid": "^0.18.0",
    "@aws-sdk/client-kms": "^3.1101.0",
    "@identity-digital/dnsid-http-signatures": "^0.18.0",
    "@identity-digital/dnsid-key-aws": "^0.18.0",
    "@identity-digital/dnsid-log-c2sp-tlog": "^0.18.0",
    "@identity-digital/dnsid-registry": "^0.18.0",
    "@identity-digital/dnsid-transport": "^0.18.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@identity-digital/dnsid-protocol": "^0.18.0",
    "@types/node": "^26.1.2",
    "jose": "^6.2.7",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
