{
  "name": "dnsid-agent-sdk-demo",
  "private": true,
  "type": "module",
  "description": "Two agents on DNSid Local, side by side: Alice runs the plugin, Bob verifies her.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "./dev.sh",
    "alice": "node --env-file-if-exists=.env server/alice.ts",
    "bob": "node server/bob.ts",
    "web": "vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@fontsource/libre-franklin": "^5.2.5",
    "@fontsource/roboto-mono": "^5.2.5",
    "@dnsid-ai/sdk": "file:../../../dnsid-ts/packages/sdk",
    "@dnsid-ai/agent-sdk-plugin": "file:../..",
    "@dnsid-ai/http-signatures": "file:../../../dnsid-ts/packages/http-signatures",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
